---
import Icon from "./Icon.astro";
import { translate, type Locale } from "../i18n";
interface Props {
  locale: Locale;
  currentLabel: string;
  catalogOnly?: boolean;
}
const { locale, currentLabel, catalogOnly = false } = Astro.props;
const t = translate(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const languageUrl =
  Astro.url.pathname.replace(
    /^\/(es|en)(\/|$)/,
    "/" + (locale === "es" ? "en" : "es") + "$2",
  ) + Astro.url.search;
const shop = [
  { path: `/${locale}/`, label: "home", icon: "home" },
  { path: `/${locale}/catalog/decants`, label: "decants", icon: "decant" },
  { path: `/${locale}/catalog/full-bottles`, label: "bottles", icon: "bottle" },
  { path: `/${locale}/orders`, label: "myOrder", icon: "receipt" },
  { path: `/${locale}/checkout`, label: "cart", icon: "bag" },
] as const;
const visibleShop = shop.filter(
  ({ label }) => !catalogOnly || !["myOrder", "cart"].includes(label),
);
const admin = [
  {
    path: "products",
    label: "products",
    icon: "grid",
    permission: "catalog:read_private",
  },
  {
    path: "inventory",
    label: "inventory",
    icon: "stock",
    permission: "inventory:read",
  },
  {
    path: "orders",
    label: "orders",
    icon: "receipt",
    permission: "orders:read",
  },
  {
    path: "media",
    label: "library",
    icon: "photo",
    permission: "catalog:write",
  },
  {
    path: "settings",
    label: "settings",
    icon: "settings",
    permission: "commerce:write",
  },
] as const;
---

<button
  type="button"
  id="main-menu-toggle"
  class="main-menu-toggle main-menu-launcher"
  aria-haspopup="dialog"
  aria-controls="main-menu-dialog"
  aria-expanded="false"
>
  <Icon name="menu" />
  <span>{t("menu")}</span>
  <small>· {currentLabel}</small>
</button>
<dialog
  id="main-menu-dialog"
  class="main-menu-dialog"
  aria-labelledby="main-menu-title"
>
  <div class="main-menu-panel">
    <div class="main-menu-heading">
      <h2 id="main-menu-title">{t("mainMenu")}</h2>
      <button
        type="button"
        class="main-menu-dismiss"
        data-menu-close
        aria-label={t("close")}
      >
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label={t("mainMenu")}>
      <h3>{t("footerShop")}</h3>
      <div
        class:list={["main-menu-grid", { "main-menu-catalog": catalogOnly }]}
      >
        {visibleShop.map(({ path, label, icon }) => (
          <a
            class="main-menu-tile"
            href={path}
            aria-current={
              currentPath === path.replace(/\/$/, "") ? "page" : undefined
            }
            data-menu-cart={label === "cart" ? "" : undefined}
          >
            <span class="main-menu-icon">
              <Icon name={icon} />
            </span>
            <span>
              {t(label)}
              {label === "cart" && <small data-cart-count>0</small>}
            </span>
          </a>
        ))}
      </div>
      {!catalogOnly && (
        <>
          <h3>{t("preferences")}</h3>
          <div class="main-menu-grid">
            <a
              class="main-menu-tile"
              href={languageUrl}
              lang={locale === "es" ? "en" : "es"}
            >
              <span class="main-menu-icon">
                <Icon name="globe" />
              </span>
              <span>
                {t("language")}
                <small>{locale === "es" ? "English" : "Español"}</small>
              </span>
            </a>
            <button
              type="button"
              class="main-menu-tile"
              data-menu-accessibility
            >
              <span class="main-menu-icon">
                <Icon name="accessibility" />
              </span>
              <span>{t("accessibility")}</span>
            </button>
          </div>
          <h3>{t("administration")}</h3>
          <div class="main-menu-grid" data-menu-admin>
            <a
              class="main-menu-tile"
              href={`/${locale}/admin/login`}
              data-menu-guest
            >
              <span class="main-menu-icon">
                <Icon name="lock" />
              </span>
              <span>{t("adminAccess")}</span>
            </a>
            {admin.map(({ path, label, icon, permission }) => (
              <a
                class="main-menu-tile"
                href={`/${locale}/admin/${path}`}
                data-menu-permission={permission}
                aria-current={
                  currentPath.startsWith(`/${locale}/admin/${path}`)
                    ? "page"
                    : undefined
                }
                hidden
              >
                <span class="main-menu-icon">
                  <Icon name={icon} />
                </span>
                <span>{t(label)}</span>
              </a>
            ))}
            <button
              type="button"
              class="main-menu-tile"
              data-logout
              data-logout-error="main-menu-error"
              hidden
            >
              <span class="main-menu-icon">
                <Icon name="logout" />
              </span>
              <span>{t("logout")}</span>
            </button>
          </div>
        </>
      )}
    </nav>
    {!catalogOnly && (
      <>
        <p id="main-menu-session" class="main-menu-status" role="status"></p>
        <div
          id="main-menu-error"
          class="notice"
          role="alert"
          tabindex="-1"
          hidden
        ></div>
      </>
    )}
  </div>
  <button type="button" class="main-menu-toggle" data-menu-close>
    <Icon name="close" />
    <span>{t("close")}</span>
  </button>
</dialog>
<script>
  import "./main-menu";
</script>
<style>
  .main-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.5rem;
    max-width: calc(100vw - 2rem);
    padding: 0.6rem 1.5rem;
    border: 0;
    border-radius: 3rem;
    background: var(--champagne);
    color: var(--black);
    box-shadow: 0 0.6rem 2rem rgb(0 0 0 / 0.55);
    font-weight: 600;
  }
  .main-menu-toggle small {
    overflow: hidden;
    max-width: 11rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 400;
  }
  .main-menu-launcher {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
  }
  .main-menu-dialog {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--white);
  }
  .main-menu-dialog[open] {
    display: grid;
    grid-template-rows: minmax(0, auto) auto;
    align-content: end;
    justify-items: center;
    gap: 1.2rem;
  }
  .main-menu-dialog::backdrop {
    background: rgb(0 0 0 / 0.62);
  }
  .main-menu-dialog :focus-visible {
    outline: 3px solid var(--champagne);
    outline-offset: 3px;
  }
  .main-menu-launcher:focus-visible {
    outline: 3px solid var(--white);
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--black);
  }
  .main-menu-dialog > .main-menu-toggle {
    background: var(--white);
  }
  .main-menu-panel {
    container: main-menu / inline-size;
    width: min(100%, 46rem);
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--studio-line);
    border-radius: 1.5rem;
    background: var(--studio-panel);
    padding: 1.2rem;
    animation: main-menu-enter 0.25s ease-out;
  }
  .main-menu-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .main-menu-heading h2 {
    margin: 0;
    font-size: 1.9rem;
  }
  .main-menu-dismiss {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--studio-line);
    border-radius: 50%;
    background: transparent;
    color: inherit;
  }
  .main-menu-panel h3 {
    margin: 1.2rem 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--champagne);
  }
  .main-menu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .main-menu-catalog {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .main-menu-tile {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--studio-line);
    border-radius: 1rem;
    background: var(--studio-panel);
    color: inherit;
    text-align: left;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .main-menu-tile:hover,
  .main-menu-tile[aria-current="page"] {
    border-color: var(--champagne);
    background: color-mix(in srgb, var(--champagne) 12%, var(--black));
  }
  .main-menu-tile[hidden] {
    display: none;
  }
  .main-menu-tile small {
    display: block;
    color: var(--studio-muted);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .main-menu-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--black);
    color: var(--champagne);
  }
  .main-menu-status {
    margin: 0.75rem 0 0;
    color: var(--studio-muted);
    font-size: 0.9rem;
  }
  .main-menu-status:empty {
    display: none;
  }
  @container main-menu (min-width: 600px) {
    .main-menu-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .main-menu-toggle small {
      display: none;
    }
    .main-menu-tile {
      gap: 0.5rem;
      padding-inline: 0.6rem;
    }
  }
  @keyframes main-menu-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
