---
interface Props {
  name:
    | "bag"
    | "search"
    | "filter"
    | "close"
    | "plus"
    | "minus"
    | "grid"
    | "stock"
    | "eye"
    | "whatsapp"
    | "arrow"
    | "previous"
    | "next"
    | "settings"
    | "photo"
    | "receipt";
}
const { name } = Astro.props;
const paths: Record<string, string[]> = {
  bag: ["M6 7h12l1 13H5L6 7Z", "M9 8V6a3 3 0 0 1 6 0v2"],
  search: ["M15.5 15.5 20 20"],
  filter: ["M4 6h16M7 12h10M10 18h4"],
  close: ["m6 6 12 12M18 6 6 18"],
  plus: ["M12 5v14M5 12h14"],
  minus: ["M5 12h14"],
  grid: ["M3 3h7v7H3ZM14 3h7v7h-7ZM3 14h7v7H3ZM14 14h7v7h-7Z"],
  stock: ["m3 7 9-4 9 4v10l-9 4-9-4V7Z", "m3 7 9 4 9-4M12 11v10"],
  eye: ["M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"],
  whatsapp: [
    "M20 11.5a8 8 0 0 1-12 7L3 20l1.5-5a8 8 0 1 1 15.5-3.5Z",
    "M8 8c0 4 4 7 7 7l1-2-3-1-1 1-2-2 1-1-1-3-2 1Z",
  ],
  arrow: ["M19 12H5m6-6-6 6 6 6"],
  previous: ["m14 6-6 6 6 6"],
  next: ["m10 6 6 6-6 6"],
  settings: ["M4 7h9M17 7h3M4 17h3M11 17h9"],
  photo: ["M4 5h16v14H4Z", "m4 16 5-5 4 4 3-3 4 4"],
  receipt: ["M6 3h12v18l-3-2-3 2-3-2-3 2V3Z", "M9 8h6M9 12h6"],
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name]?.map((d) => (
    <path d={d} />
  ))}
  {name === "search" && <circle cx="10.5" cy="10.5" r="6.5" />}
  {name === "eye" && <circle cx="12" cy="12" r="3" />}
  {name === "settings" && <circle cx="15" cy="7" r="2" />}
  {name === "settings" && <circle cx="9" cy="17" r="2" />}
  {name === "photo" && <circle cx="9" cy="9.5" r="1.5" />}
</svg>
