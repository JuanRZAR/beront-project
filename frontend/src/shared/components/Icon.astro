---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name]?.map((d) => (
    <path d={d} />
  ))}
  {name === "search" && <circle cx="10.5" cy="10.5" r="6.5" />}
  {name === "eye" && <circle cx="12" cy="12" r="3" />}
  {name === "settings" && <circle cx="15" cy="7" r="2" />}
  {name === "accessibility" && <circle cx="12" cy="4.5" r="1.8" />}
  {name === "settings" && <circle cx="9" cy="17" r="2" />}
  {name === "photo" && <circle cx="9" cy="9.5" r="1.5" />}
  {name === "globe" && <circle cx="12" cy="12" r="9" />}
</svg>
