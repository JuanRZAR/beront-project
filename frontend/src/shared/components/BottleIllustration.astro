}
const { hero = false } = Astro.props;
---

<svg
  viewBox="0 0 300 340"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <ellipse
    cx="150"
    cy="314"
    rx="79"
    ry="8"
    fill="#0B0B0B"
