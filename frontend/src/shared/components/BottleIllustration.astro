  ></ellipse>
  <rect x="107" y="39" width="86" height="62" rx="3" fill="#0B0B0B"></rect>
  <path d="M111 45h3v48h-3Z" fill="#F8F8F8" opacity=".2"></path>
  <rect x="124" y="99" width="52" height="18" fill="#B8A58A"></rect>
  <rect x="72" y="114" width="156" height="191" rx="12" fill="#0B0B0B"></rect>
  <path
    d="M81 128v157c0 5 3 8 8 8"
