---
import Icon from "../../shared/components/Icon.astro";
import { translate, type Locale, number } from "../../shared/i18n";
import { safeJson, mediaUrl } from "../../shared/http/serialization";
import type { Product, Brand, OptionRow } from "../../shared/http/contracts";
interface Props {
  locale: Locale;
  product?: Product;
  brands: Brand[];
  categories: OptionRow[];
  audiences: OptionRow[];
}
const { locale, product, brands, categories, audiences } = Astro.props,
  t = translate(locale);
---

<div class="page-heading">
  <div>
    <h1>{t(product ? "editProduct" : "newProduct")}</h1>
    <p>{product?.name ?? t("manageCatalog")}</p>
  </div>
  <a class="text-button" href={`/${locale}/admin/products`}>
    {t("back")}
  </a>
</div>
{Astro.url.searchParams.get("created") === "1" && (
  <div class="notice">{t("created")}</div>
)}
<form id="product-form" class="editor-panel">
  <div class="form-grid">
    <label class="field">
      <span>{t("name")}</span>
      <input
        name="name"
        id="edit-name"
        value={product?.name ?? ""}
        required
        maxlength="120"
      />
    </label>
    <div class="field">
      <label for="brand-id">{t("house")}</label>
      <select name="brand_id" id="brand-id" required>
        <option value="">{t("house")}</option>
        {brands.map((brand) => (
          <option value={brand.id} selected={brand.id === product?.brand.id}>
            {brand.name}
            {!brand.active ? " · " + t("inactive") : ""}
          </option>
        ))}
      </select>
      <div class="inline-actions">
        <button type="button" class="text-button" id="new-brand">
          {t("addHouse")}
        </button>
        <button type="button" class="text-button" id="edit-brand">
          {t("edit")}
        </button>
      </div>
    </div>
    <label class="field wide">
      <span>{t("slug")}</span>
      <input
        name="slug"
        id="product-slug"
        value={product?.slug ?? ""}
        required
        maxlength="160"
        pattern="[a-z0-9]+(-[a-z0-9]+)*"
      />
    </label>
    <label class="field">
      <span>{t("audience")}</span>
      <select name="audience" required>
        {audiences.map((row) => (
          <option
            value={row.slug}
            selected={
              product ? product.audience === row.slug : row.slug === "unisex"
            }
          >
            {locale === "en" ? row.name_en : row.name_es}
          </option>
        ))}
      </select>
    </label>
    <label class="field wide">
      <span>{t("descriptionSpanish")}</span>
      <textarea
        name="description_es"
        maxlength="5000"
        lang="es"
      >{product?.description_es ?? ""}</textarea>
    </label>
    <label class="field wide">
      <span>{t("descriptionEnglish")}</span>
      <textarea
        name="description_en"
        maxlength="5000"
        lang="en"
      >{product?.description_en ?? ""}</textarea>
    </label>
    {product && (
      <fieldset class="wide filter-group">
        <>
          <legend>{t("productStatus")}</legend>
          <div class="check-row">
            <>
              <label>
                <input
                  type="checkbox"
                  name="published"
                  checked={product.published}
                />
                {t("published")}
              </label>
              <label>
                <input
                  type="checkbox"
                  name="sold_out"
                  checked={product.sold_out}
                />
                {t("markSoldOut")}
              </label>
              <label>
                <input
                  type="checkbox"
                  name="archived"
                  checked={product.archived}
                />
                {t("archive")}
              </label>
            </>
          </div>
        </>
      </fieldset>
    )}
  </div>
  <div class="notice" data-form-error tabindex="-1" hidden></div>
  <div class="form-actions">
    <a class="button outline" href={`/${locale}/admin/products`}>
      {t("cancel")}
    </a>
    <button class="button champagne" type="submit">
      {t(product ? "saveChanges" : "save")}
    </button>
  </div>
</form>
{product && (
  <>
    <section class="editor-panel">
      <>
        <h2>{t("presentations")}</h2>
        <p class="hint">{t("immutableVolume")}</p>
        <div id="variant-list">
          {product.variants.map((variant) => (
            <form
              class="variant-form"
              data-variant-id={variant.id}
              data-version={variant.version}
            >
              <h3>
                {t(variant.kind === "decant" ? "decant" : "fullBottle")} ·{" "}
                {number(variant.volume_ml)} ml
              </h3>
              <div class="form-grid">
                <label class="field">
                  <span>{t("priceUsd")}</span>
                  <input
                    name="price"
                    type="number"
                    step=".01"
                    min=".01"
                    max="9999999999.99"
                    required
                    value={variant.price}
                  />
                </label>
                <div class="check-row">
                  <label>
                    <input
                      name="active"
                      type="checkbox"
                      checked={variant.active}
                    />
                    {t("active")}
                  </label>
                  <label>
                    <input
                      name="sold_out"
                      type="checkbox"
                      checked={variant.sold_out}
                    />
                    {t("markSoldOut")}
                  </label>
                </div>
              </div>
              <div class="notice" data-form-error tabindex="-1" hidden />
              <button class="button outline small" type="submit">
                {t("saveChanges")}
              </button>
            </form>
          ))}
        </div>
      </>
      <form id="variant-create-form" class="variant-form">
        <>
          <h3>{t("addPresentation")}</h3>
          <div class="inline-variant">
            <>
              <label class="field">
                <>
                  <span>{t("type")}</span>
                  <select name="kind">
                    <>
                      <option value="decant">{t("decant")}</option>
                      <option value="full_bottle">{t("fullBottle")}</option>
                    </>
                  </select>
                </>
              </label>
              <label class="field">
                <>
                  <span>{t("volume")}</span>
                  <input
                    name="volume_ml"
                    type="number"
                    step=".01"
                    min=".01"
                    max="9999999999.99"
                    list="decant-volumes"
                    required
                  />
                  <datalist id="decant-volumes">
                    <>
                      <option value="3" />
                      <option value="5" />
                      <option value="10" />
                    </>
                  </datalist>
                </>
              </label>
              <label class="field">
                <>
                  <span>{t("priceUsd")}</span>
                  <input
                    name="price"
                    type="number"
                    step=".01"
                    min=".01"
                    max="9999999999.99"
                    required
                  />
                </>
              </label>
            </>
          </div>
          <div class="notice" data-form-error tabindex="-1" hidden />
          <button class="button champagne small" type="submit">
            {t("addVariant")}
          </button>
        </>
      </form>
    </section>
    <section class="editor-panel">
      <>
        <h2>{t("photo")}</h2>
        <p class="hint">{t("imageLimits")}</p>
        <div id="image-list">
          {product.images.map((image) => (
            <form
              class="image-form"
              data-image-id={image.id}
              data-version={image.version}
            >
              <img
                class="admin-photo"
                src={mediaUrl(image.url)}
                alt={
                  (locale === "en"
                    ? image.alt_en || image.alt_es
                    : image.alt_es) || product.name
                }
                width="130"
                height="160"
              />
              <div class="form-grid">
                <label class="field">
                  <span>{t("altEs")}</span>
                  <input name="alt_es" maxlength="250" value={image.alt_es} />
                </label>
                <label class="field">
                  <span>{t("altEn")}</span>
                  <input name="alt_en" maxlength="250" value={image.alt_en} />
                </label>
                <label class="field">
                  <span>{t("position")}</span>
                  <input
                    name="position"
                    type="number"
                    min="0"
                    max="100"
                    required
                    value={image.position}
                  />
                </label>
              </div>
              <div class="notice" data-form-error tabindex="-1" hidden />
              <div class="inline-actions">
                <button class="button outline small" type="submit">
                  {t("saveChanges")}
                </button>
                <button class="text-button" type="button" data-delete-image>
                  {t("deletePhoto")}
                </button>
              </div>
            </form>
          ))}
        </div>
      </>
      <form id="image-upload-form" class="demo-upload">
        <>
          <label class="field">
            <>
              <span>{t("uploadPhoto")}</span>
              <input
                name="file"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                required
              />
            </>
          </label>
          <div class="form-grid">
            <>
              <label class="field">
                <>
                  <span>{t("altEs")}</span>
                  <input name="alt_es" maxlength="250" />
                </>
              </label>
              <label class="field">
                <>
                  <span>{t("altEn")}</span>
                  <input name="alt_en" maxlength="250" />
                </>
              </label>
              <label class="field">
                <>
                  <span>{t("position")}</span>
                  <input
                    name="position"
                    type="number"
                    min="0"
                    max="100"
                    value="0"
                  />
                </>
              </label>
            </>
          </div>
          <div class="notice" data-form-error tabindex="-1" hidden />
          <button class="button champagne small" type="submit">
            {t("uploadPhoto")}
          </button>
        </>
      </form>
    </section>
  </>
)}
<dialog
  id="brand-dialog"
  class="dialog small-dialog"
  aria-labelledby="brand-title"
>
  <form id="brand-form">
    <div class="dialog-heading">
      <h2 id="brand-title">{t("newHouse")}</h2>
      <button
        class="icon-button"
        type="button"
        data-close-brand
        aria-label={t("close")}
      >
        <Icon name="close" />
      </button>
    </div>
    <label class="field">
      <span>{t("name")}</span>
      <input name="name" maxlength="100" required />
    </label>
    <label class="field">
      <span>{t("brandCategory")}</span>
      <select name="category_id" required>
        {categories.map((row) => (
          <option value={row.id}>
            {locale === "en" ? row.name_en : row.name_es}
          </option>
        ))}
      </select>
    </label>
    <label class="check-label">
      <input name="active" type="checkbox" checked />
      {t("active")}
    </label>
    <div class="notice" data-form-error tabindex="-1" hidden></div>
    <div class="form-actions">
      <button type="button" class="button outline" data-close-brand>
        {t("cancel")}
      </button>
      <button type="submit" class="button champagne">
        {t("save")}
      </button>
    </div>
  </form>
</dialog>
<template id="variant-template">
  <form class="variant-form">
    <h3 data-variant-name></h3>
    <div class="form-grid">
      <label class="field">
        <span>{t("priceUsd")}</span>
        <input
          name="price"
          type="number"
          step=".01"
          min=".01"
          max="9999999999.99"
          required
        />
      </label>
      <div class="check-row">
        <label>
          <input name="active" type="checkbox" />
          {t("active")}
        </label>
        <label>
          <input name="sold_out" type="checkbox" />
          {t("markSoldOut")}
        </label>
      </div>
    </div>
    <div class="notice" data-form-error tabindex="-1" hidden></div>
    <button class="button outline small" type="submit">
      {t("saveChanges")}
    </button>
  </form>
</template>
<template id="image-template">
  <form class="image-form">
    <img class="admin-photo" width="130" height="160" alt="" />
    <div class="form-grid">
      <label class="field">
        <span>{t("altEs")}</span>
        <input name="alt_es" maxlength="250" />
      </label>
      <label class="field">
        <span>{t("altEn")}</span>
        <input name="alt_en" maxlength="250" />
      </label>
      <label class="field">
        <span>{t("position")}</span>
        <input name="position" type="number" min="0" max="100" required />
      </label>
    </div>
    <div class="notice" data-form-error tabindex="-1" hidden></div>
    <div class="inline-actions">
      <button class="button outline small" type="submit">
        {t("saveChanges")}
      </button>
      <button class="text-button" type="button" data-delete-image>
        {t("deletePhoto")}
      </button>
    </div>
  </form>
</template>
<script
  type="application/json"
  id="editor-data"
  set:html={safeJson({ product, brands })}
/>
<script>
  import "./editor";
</script>
