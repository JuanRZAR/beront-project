---
import Layout from "../../../../shared/layouts/AdminLayout.astro";
import Icon from "../../../../shared/components/Icon.astro";
import { isLocale, translate } from "../../../../shared/i18n";
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const t = translate(locale);
---

<Layout locale={locale} title={t("libraryTitle")} active="media">
  <div class="page-heading">
    <div>
      <h1>{t("libraryTitle")}</h1>
      <p>{t("libraryIntro")}</p>
    </div>
  </div>
  <div class="gallery-tools">
    <label class="commerce-field">
      <span>{t("searchPhoto")}</span>
      <input
        id="media-search"
        type="search"
        maxlength="120"
        placeholder={t("searchPhotoHelp")}
      />
    </label>
    <label class="commerce-button secondary" id="upload-label">
      <span>{t("uploadPhoto")}</span>
      <input
        id="media-upload"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        class="visually-hidden"
      />
    </label>
  </div>
  <p id="media-count" class="commerce-note" role="status"></p>
  <p class="notice" id="media-error" role="alert" tabindex="-1" hidden></p>
  <div id="media-gallery" class="media-gallery"></div>
  <nav class="media-pager" aria-label={t("page")}>
    <button class="commerce-button secondary" id="media-prev" type="button">
      {t("previous")}
    </button>
    <span id="media-page"></span>
    <button class="commerce-button secondary" id="media-next" type="button">
      {t("next")}
    </button>
  </nav>
  <dialog id="asset-dialog" class="dialog" aria-labelledby="asset-title">
    <div class="dialog-heading">
      <h2 id="asset-title">{t("photoDetails")}</h2>
      <button
        class="icon-button"
        type="button"
        data-close
        aria-label={t("close")}
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="media-preview">
      <img id="asset-image" alt="" />
    </div>
    <form id="asset-form">
      <label class="commerce-field">
        <span>{t("photoName")}</span>
        <input name="name" maxlength="250" />
      </label>
      <div class="commerce-actions">
        <button class="commerce-button">{t("save")}</button>
        <button class="text-button" type="button" id="asset-delete">
          {t("deletePhoto")}
        </button>
      </div>
      <p class="notice" data-form-error role="alert" tabindex="-1" hidden></p>
    </form>
    <hr />
    <form id="link-form">
      <h3>{t("linkToPerfume")}</h3>
      <label class="commerce-field">
        <span>{t("searchPerfume")}</span>
        <input id="perfume-search" type="search" maxlength="120" />
      </label>
      <label class="commerce-field">
        <span>{t("perfume")}</span>
        <select id="perfume-select" required></select>
      </label>
      <p class="commerce-note">{t("linkHelp")}</p>
      <button class="commerce-button secondary">{t("linkPhoto")}</button>
      <p class="notice" data-form-error role="alert" tabindex="-1" hidden></p>
    </form>
    <p id="asset-status" class="form-status" role="status"></p>
  </dialog>
</Layout>
<script>
  import "../../../../features/media/page";
</script>
