---
import Layout from "../../../../shared/layouts/AdminLayout.astro";
import Editor from "../../../../features/admin/ProductEditor.astro";
import Notice from "../../../../shared/components/Notice.astro";
import { isLocale, translate } from "../../../../shared/i18n";
import { serverGet } from "../../../../shared/http/server";
import { ApiError, errorMessage } from "../../../../shared/http/errors";
import type {
  Product,
  Brand,
  OptionRow,
} from "../../../../shared/http/contracts";
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const cookie = Astro.request.headers.get("cookie") ?? "";
let product: Product | undefined,
  brands: Brand[] = [],
  categories: OptionRow[] = [],
  audiences: OptionRow[] = [],
  error = "";
try {
  const [p, b, c, a] = await Promise.all([
    serverGet<Product>(
      "/api/v1/admin/products/" + encodeURIComponent(Astro.params.id ?? ""),
      cookie,
    ),
    serverGet<Brand[]>("/api/v1/admin/brands", cookie),
    serverGet<OptionRow[]>("/api/v1/admin/catalog-options/categories", cookie),
    serverGet<OptionRow[]>("/api/v1/admin/catalog-options/audiences", cookie),
  ]);
  product = p.data;
  brands = b.data;
  categories = c.data.filter((row) => row.active);
  audiences = a.data.filter((row) => row.active);
} catch (err) {
  error =
    err instanceof ApiError && err.status === 404
      ? translate(locale)("productUnavailable")
      : errorMessage(err, locale);
  Astro.response.status = err instanceof ApiError ? err.status : 503;
}
---

<Layout
  title={translate(locale)("editProduct")}
  locale={locale}
  active="catalog"
>
  {error ? (
    <Notice locale={locale} message={error} retry />
  ) : (
    <Editor
      locale={locale}
      product={product}
      brands={brands}
      categories={categories}
      audiences={audiences}
    />
  )}
</Layout>
