---
import Layout from "../../../../shared/layouts/AdminLayout.astro";
import Editor from "../../../../features/admin/ProductEditor.astro";
import Notice from "../../../../shared/components/Notice.astro";
import { isLocale, translate } from "../../../../shared/i18n";
import { serverGet } from "../../../../shared/http/server";
import { errorMessage } from "../../../../shared/http/errors";
import { loadOptions } from "../../../../features/admin/options";
import type { Brand } from "../../../../shared/http/contracts";
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
let brands: Brand[] = [],
  options: Awaited<ReturnType<typeof loadOptions>> | undefined,
  error = "";
try {
  const cookie = Astro.request.headers.get("cookie") ?? "";
  [{ data: brands }, options] = await Promise.all([
    serverGet<Brand[]>("/api/v1/admin/brands", cookie),
    loadOptions(cookie),
  ]);
} catch (err) {
  error = errorMessage(err, locale);
}
---

<Layout
  title={translate(locale)("newProduct")}
  locale={locale}
  active="catalog"
>
  {error || !options ? (
    <Notice locale={locale} message={error} retry />
  ) : (
    <Editor locale={locale} brands={brands} {...options} />
  )}
</Layout>
