{
  "name": "beront-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun --bun astro dev --host 127.0.0.1",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --host 127.0.0.1",
    "check": "bun --bun astro check",
    "lint": "eslint .",
    "format": "prettier --check src tests astro.config.mjs eslint.config.js prettier.config.mjs tsconfig.json package.json playwright.config.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:app": "uv run --project ../backend python ../backend/tests/integration/frontend_browser.py"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "@astrojs/node": "^11.1.9",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.0",
    "@types/bun": "^1.3.0",
    "@playwright/test": "^1.58.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.7.0",
    "prettier-plugin-astro": "^1.1.2"
  }
}
