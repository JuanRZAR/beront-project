# Copiar a deploy/deploy-dev/.env (no se sube al repositorio). Valores solo para este equipo.
# Dentro de Docker la base se llama "db"; desde el equipo es 127.0.0.1:5433.
APP_ENV=production
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://beront:beront@db:5432/beront
FRONTEND_ORIGIN=http://localhost:8000
CART_REQUIRES_STOCK=true
BACKEND_URL=http://api:8000
SITE_HOSTS=localhost
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
