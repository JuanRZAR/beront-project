# Nombres de las variables de producción. El admin crea el .env real en /srv/apps/beront/.env.
# Los valores escritos aquí no son secretos; los vacíos los completa el admin o el propietario.
# Lo leen app (Astro) y api (Flask).
APP_ENV=production
DATABASE_URL=
SECRET_KEY=
FRONTEND_ORIGIN=https://beront.com
CART_REQUIRES_STOCK=true
BACKEND_URL=http://api:8000
SITE_HOSTS=beront.com
TRUST_PROXY=true
# Correo (Gmail con contraseña de aplicación). Vacío: la recuperación de códigos responde 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
